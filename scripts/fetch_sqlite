#!/usr/bin/env python
"""
Fetch the SQLite amalgamation (sqlite3.c and sqlite3.h) into the repository
root.

Usage: fetch_sqlite [version]

With no argument the current release is fetched. With a version, e.g.
"3.51.2", that release is fetched instead.
"""
from urllib.request import Request, urlopen
import datetime
import os
import re
import shutil
import sys
import tempfile
import zipfile


CUR_DIR = os.path.dirname(__file__)


def find_latest():
    try:
        with urlopen('https://sqlite.org/download.html') as fh:
            html = fh.read().decode('utf8')
    except Exception as exc:
        raise RuntimeError('Could not fetch sqlite download page: %s' % exc)

    match = re.search(r'(\d{4}/sqlite-amalgamation-\d+\.zip)', html)
    if match is None:
        raise RuntimeError('Could not find amalgamation on download page.')
    return 'https://sqlite.org/%s' % match.group(1)


def find_version(version):
    parts = version.split('.')
    try:
        major, minor = int(parts[0]), int(parts[1])
        patch = int(parts[2]) if len(parts) > 2 else 0
    except (IndexError, ValueError):
        raise RuntimeError('Invalid version %r, expected e.g. "3.51.2".'
                           % version)

    filename = 'sqlite-amalgamation-%d%02d%02d00.zip' % (major, minor, patch)

    # Release URLs are prefixed with the release year, probe backwards.
    year = datetime.date.today().year
    for y in range(year, 2012, -1):
        url = 'https://sqlite.org/%d/%s' % (y, filename)
        try:
            with urlopen(Request(url, method='HEAD')):
                return url
        except Exception:
            continue
    raise RuntimeError('Could not find %s on sqlite.org.' % filename)


def download(url):
    with tempfile.NamedTemporaryFile(suffix='.zip') as tmp:
        print('Downloading %s' % url)
        with urlopen(url) as fh:
            shutil.copyfileobj(fh, tmp)
        tmp.seek(0)
        with zipfile.ZipFile(tmp) as zf:
            for path in zf.namelist():
                filename = os.path.basename(path)
                if filename not in ('sqlite3.c', 'sqlite3.h'):
                    continue

                dest = os.path.join(CUR_DIR, '../', filename)
                with zf.open(path) as src, open(dest, 'wb') as fh_out:
                    shutil.copyfileobj(src, fh_out)
                print('Wrote %s' % os.path.abspath(dest))


if __name__ == '__main__':
    url = find_version(sys.argv[1]) if len(sys.argv) > 1 else find_latest()
    download(url)
