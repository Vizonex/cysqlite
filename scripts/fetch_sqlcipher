#!/bin/bash
#
# Build the SQLCipher source amalgamation (sqlite3.c and sqlite3.h) and place
# it in the repository root.
#
# Usage: fetch_sqlcipher [tag]
#
# With no argument the latest SQLCipher is used. With a tag, e.g. "v4.7.0",
# that release is used instead. Feature flags are applied by cysqlite's
# setup.py when the amalgamation is compiled, not here.

set -e

curdir=$(realpath $(dirname "$0"))
dest=$(dirname "$curdir")
tag="$1"

cd "$curdir"

if [[ ! -d sqlcipher ]]; then
  git -c advice.detachedHead=false clone -q --depth 1 \
    ${tag:+--branch "$tag"} https://github.com/sqlcipher/sqlcipher
elif [[ -n "$tag" ]]; then
  echo "scripts/sqlcipher checkout already exists, remove it to fetch $tag" >&2
  exit 1
fi

cd sqlcipher
echo "sqlcipher revision: $(git describe --tags --always)"

./configure --disable-tcl --fts3 --fts4 --fts5 --update-limit \
  --enable-load-extension --enable-threadsafe > /dev/null
make sqlite3.c sqlite3.h > /dev/null

cp sqlite3.c sqlite3.h "$dest"
echo "Wrote $dest/sqlite3.c"
echo "Wrote $dest/sqlite3.h"
